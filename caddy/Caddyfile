{
    # Admin API for dynamic SSL issuance and on-demand reload
    admin 0.0.0.0:2019
}

# Default HTTP entry point forwarding traffic to app container
:80 {
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
